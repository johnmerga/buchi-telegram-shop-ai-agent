# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://buchi:buchi@localhost:5432/buchi

# Secret that cron-job.org sends in the x-job-secret header, at least 32 characters.
# DEV ONLY: this placeholder is public. In production, generate one with `openssl rand -hex 32`.
JOB_SECRET=dev-only-job-secret-do-not-use-in-production

# Secret that signs the API bearer tokens, at least 32 characters. Generate one with
# `openssl rand -hex 32`.
AUTH_TOKEN_SECRET=

# Bot token from BotFather.
TELEGRAM_BOT_TOKEN=
# Secret that Telegram sends in the x-telegram-bot-api-secret-token header: 32 to 256 characters of
# A-Z, a-z, 0-9, _ and -. Generate one with `openssl rand -hex 32`.
TELEGRAM_WEBHOOK_SECRET=

# Gemini API key from Google AI Studio (free tier, no card needed).
GEMINI_API_KEY=
# Model IDs for each tier. These are suggestions to verify in AI Studio before use, because model
# names change.
GEMINI_MODEL_FAST=gemini-2.5-flash-lite
GEMINI_MODEL_SMART=gemini-2.5-flash
GEMINI_MODEL_EMBED=gemini-embedding-001
# Buchi's own request budget, kept under the free tier's limits.
GEMINI_REQUESTS_PER_MINUTE=10
GEMINI_REQUESTS_PER_DAY=250

# Secret that keys the payer hashes in the shared risk signals, at least 32 characters. Generate
# one with `openssl rand -hex 32`. Changing it makes Buchi forget every earlier signal.
RISK_HASH_SECRET=

# Optional. The evaluation runner drops and recreates this database on every run.
# EVALS_DATABASE_URL=postgres://buchi:buchi@localhost:5432/buchi_evals

# OpenRouteService key from https://account.heigit.org (free basic key, no card).
ORS_API_KEY=
# HeiGIT's API host. api.openrouteservice.org is shut down.
ORS_BASE_URL=https://api.heigit.org
# Identifies Buchi to OpenStreetMap Nominatim, as its usage policy requires.
NOMINATIM_USER_AGENT=Buchi/1.0 (contact via GitHub johnmerga/buchi-telegram-shop-ai-agent)
