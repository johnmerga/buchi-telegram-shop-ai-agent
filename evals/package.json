  },
  "dependencies": {
    "@buchi/server": "workspace:*",
    "@buchi/shared": "workspace:*",
    "@google/genai": "^2.32.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
